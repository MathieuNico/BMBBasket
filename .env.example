# Copie ce fichier sous le nom .env.local puis remplis les deux valeurs
# (Supabase : Project Settings > API). Sans elles, l'application reste en mode « sur cet appareil ».
# Utilise uniquement la clé publique (« anon » ou « publishable »), jamais la clé secrète « service_role ».
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
